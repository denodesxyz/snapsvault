# Copy to .env.local and fill in. Never commit values.
# MongoDB connection string and a GitHub token that can read public repositories (the sync reads the registry).
MONGODB_URI=
GITHUB_TOKEN=
# Registry location; the defaults are the public registry.
GITHUB_DATA_OWNER=denodesxyz
GITHUB_DATA_REPO=snapsvault-registry
GITHUB_DATA_BRANCH=main
# Bearer secret for /api/sync-snapshots.
CRON_SECRET=
# Optional https origin that /feeds/<name>.json requests are forwarded to; when unset, nothing is forwarded.
FEEDS_ORIGIN=
