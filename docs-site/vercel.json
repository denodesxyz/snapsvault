{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "docs.snapsvault.xyz"
        }
      ],
      "destination": "https://docs.snapsvault.xyz/overview/what-is-snapsvault",
      "permanent": false
    },
    {
      "source": "/overview/introduction",
      "destination": "/overview/what-is-snapsvault",
      "permanent": true
    },
    {
      "source": "/overview/coverage",
      "destination": "/overview/quickstart",
      "permanent": true
    },
    {
      "source": "/overview/api-reference",
      "destination": "/core-components/rest-api",
      "permanent": true
    },
    {
      "source": "/overview/faq",
      "destination": "/overview/what-is-snapsvault",
      "permanent": true
    },
    {
      "source": "/quickstart/use-the-marketplace-ui",
      "destination": "/overview/quickstart",
      "permanent": true
    },
    {
      "source": "/quickstart/install-and-use-snapsos",
      "destination": "/core-components/snapsos-cli",
      "permanent": true
    },
    {
      "source": "/core-components/framework",
      "destination": "/contributing/list-your-snapshots",
      "permanent": true
    },
    {
      "source": "/core-components/snapsos",
      "destination": "/core-components/snapsos-cli",
      "permanent": true
    },
    {
      "source": "/contributing/contribute-snapshots",
      "destination": "/contributing/list-your-snapshots",
      "permanent": true
    },
    {
      "source": "/contributing/improve-cli-or-frontend",
      "destination": "/contributing/contribute",
      "permanent": true
    },
    {
      "source": "/contributing/feature-requests",
      "destination": "/contributing/contribute",
      "permanent": true
    },
    {
      "source": "/core-components/registry",
      "destination": "/contributing/registry-file",
      "permanent": true
    },
    {
      "source": "/core-components/snapshot-feeds",
      "destination": "/contributing/feed-format",
      "permanent": true
    },
    {
      "source": "/contributing/improve-snapsos-and-the-app",
      "destination": "/contributing/contribute",
      "permanent": true
    },
    {
      "source": "/contributing/request-a-feature",
      "destination": "/contributing/contribute",
      "permanent": true
    }
  ]
}
